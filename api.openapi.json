{
  "openapi": "3.1.0",
  "info": {
    "title": "SYA Scheduler Function API",
    "version": "0.1.0",
    "description": "Scheduler host bridge plus the planner API other SYA modules call. /api/scheduler reads the active tree. /api/v1 lists projects and accepts init, revise, status, translation, tree, and voyage calls. Live docs are served at /docs."
  },
  "servers": [
    {
      "url": "http://localhost:{port}",
      "description": "Local SYA function runtime. Electron assigns the port dynamically.",
      "variables": {
        "port": {
          "default": "0"
        }
      }
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Scheduler function health check",
        "responses": {
          "200": {
            "description": "Runtime is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/manifest": {
      "get": {
        "operationId": "manifest",
        "summary": "Scheduler function manifest",
        "responses": {
          "200": {
            "description": "Function manifest",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "operationId": "projects.list",
        "summary": "List concurrent projects, oldest first",
        "responses": {
          "200": {
            "description": "Project list. Does not change the active tree.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/init": {
      "post": {
        "operationId": "tasks.init",
        "summary": "Create a project from a goal, persona, and optional deadline",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Planning event accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAck"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/{task_id}/revise": {
      "post": {
        "operationId": "tasks.revise",
        "summary": "Revise unfinished branches of one project",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Revise event accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAck"
                }
              }
            }
          },
          "404": {
            "description": "Project is not initialized"
          }
        }
      }
    },
    "/api/v1/tasks/{task_id}/status": {
      "patch": {
        "operationId": "tasks.status",
        "summary": "Update one leaf task status",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status event accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventAck"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/translate": {
      "post": {
        "operationId": "tasks.translate",
        "summary": "Translate task wording for display without changing the stored tree",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TranslateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Translated titles and descriptions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranslateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tasks/tree": {
      "get": {
        "operationId": "tasks.tree",
        "summary": "Read the active task tree",
        "responses": {
          "200": {
            "description": "Active task tree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Task tree is not initialized"
          }
        }
      }
    },
    "/api/v1/voyage": {
      "get": {
        "operationId": "voyage.get",
        "summary": "Read the active voyage",
        "responses": {
          "200": {
            "description": "Active voyage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Voyage is not initialized"
          }
        }
      }
    },
    "/api/scheduler/decompose": {
      "post": {
        "operationId": "decompose",
        "summary": "Decompose natural-language input into tasks and timeline events",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecomposeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decomposition result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/tasks": {
      "get": {
        "operationId": "tasks.list",
        "summary": "List tasks",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/tasks/{taskId}": {
      "get": {
        "operationId": "tasks.get",
        "summary": "Get one task",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "tasks.update",
        "summary": "Update a task",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        },
        "description": "Save title, description, status, estimatedMinutes (1–1440), deadline and scheduledDate (YYYY-MM-DD or null). All confirmed projects are addressable."
      },
      "delete": {
        "operationId": "tasks.delete",
        "summary": "Delete a task",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/timeline": {
      "get": {
        "operationId": "timeline.get",
        "summary": "Get timeline view",
        "responses": {
          "200": {
            "description": "Timeline data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/tasks/reorder": {
      "post": {
        "operationId": "tasks.reorder",
        "summary": "Reorder tasks",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReorderTasksRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reorder result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/stats": {
      "get": {
        "operationId": "stats.get",
        "summary": "Get daily task statistics",
        "responses": {
          "200": {
            "description": "Daily stats",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/config": {
      "get": {
        "operationId": "config.get",
        "summary": "Get scheduler configuration",
        "responses": {
          "200": {
            "description": "Scheduler configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "config.update",
        "summary": "Update scheduler configuration",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated scheduler configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        },
        "description": "Persist configuration. workStart/workEnd are HH:mm with start before end. dailyGranularity is fine, standard or coarse."
      }
    },
    "/api/scheduler/events": {
      "get": {
        "operationId": "events",
        "summary": "Server-sent event stream",
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/actions": {
      "get": {
        "operationId": "actions.list",
        "summary": "List callable actions",
        "responses": {
          "200": {
            "description": "Action list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/plans/preview": {
      "post": {
        "operationId": "plans.preview",
        "summary": "Preview a four-level AI plan without saving. Missing/failed model returns error; no sample fallback.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attachments": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Function response with tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Invalid or already confirmed plan"
          },
          "422": {
            "description": "Invalid input or unavailable model"
          }
        }
      }
    },
    "/api/scheduler/plans/confirm": {
      "post": {
        "operationId": "plans.confirm",
        "summary": "Explicitly confirm a pending four-level tree. Duplicate ids reject. Persist under host-owned scheduler storage.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "tree"
                ],
                "properties": {
                  "tree": {
                    "$ref": "#/components/schemas/PlanNode"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Function response with tree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FunctionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Invalid or already confirmed plan"
          },
          "422": {
            "description": "Invalid input or unavailable model"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FunctionResponse": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "data": {},
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "DecomposeRequest": {
        "type": "object",
        "required": [
          "input"
        ],
        "additionalProperties": false,
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "InitTaskRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "goal"
        ],
        "properties": {
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "persona": {
            "type": "string",
            "minLength": 1,
            "default": "balanced"
          },
          "deadline_days": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "UpdateTaskStatusRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "IN_PROGRESS",
              "DONE",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "actual_time": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "TranslateNode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      },
      "TranslateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "nodes"
        ],
        "properties": {
          "target": {
            "type": "string",
            "enum": [
              "zh",
              "en"
            ]
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/TranslateNode"
            }
          }
        }
      },
      "TranslateResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodes"
        ],
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranslateNode"
            }
          }
        }
      },
      "EventAck": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepted",
          "event_id"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "event_id": {
            "type": "string"
          }
        }
      },
      "ProjectList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ReorderTasksRequest": {
        "type": "object",
        "required": [
          "taskIds"
        ],
        "additionalProperties": false,
        "properties": {
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "PlanNode": {
        "type": "object",
        "required": [
          "task_id",
          "title",
          "estimated_time",
          "children"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "estimated_time": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "status": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_leaf": {
            "type": "boolean"
          },
          "actual_time": {
            "type": [
              "number",
              "null"
            ]
          },
          "deadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "scheduled_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanNode"
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
